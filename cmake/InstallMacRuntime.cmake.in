# Dependencies may carry absolute install names. Copying
# them alone leaves the installed executable tied to the build machine.
set(runtime_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(runtime_executable "${runtime_prefix}/@CMAKE_INSTALL_BINDIR@/playground")
set(runtime_libraries "${runtime_prefix}/@CMAKE_INSTALL_LIBDIR@")
find_program(runtime_otool otool REQUIRED)
find_program(runtime_install_name_tool install_name_tool REQUIRED)
find_program(runtime_codesign codesign REQUIRED)

file(GLOB runtime_dylibs "${runtime_libraries}/*.dylib")
file(GLOB runtime_framework_dylibs "${runtime_prefix}/@CMAKE_INSTALL_BINDIR@/../Frameworks/*.dylib")
list(APPEND runtime_dylibs ${runtime_framework_dylibs})
set(runtime_binaries ${runtime_dylibs} "${runtime_executable}")
foreach(runtime_binary IN LISTS runtime_binaries)
    if(IS_SYMLINK "${runtime_binary}")
        continue()
    endif()
    get_filename_component(runtime_directory "${runtime_binary}" DIRECTORY)
    get_filename_component(runtime_binary_name "${runtime_binary}" NAME)
    file(RELATIVE_PATH runtime_relative_libdir "${runtime_directory}" "${runtime_libraries}")
    # Assemble the dyld token after configure_file's @VAR@ substitution.
    string(CONCAT runtime_loader "@" "loader_path")
    if(runtime_relative_libdir)
        string(APPEND runtime_loader "/${runtime_relative_libdir}")
    endif()
    execute_process(COMMAND "${runtime_otool}" -L "${runtime_binary}"
        OUTPUT_VARIABLE runtime_dependencies COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" runtime_dependencies "${runtime_dependencies}")
    set(runtime_changes)
    foreach(runtime_dependency IN LISTS runtime_dependencies)
        if(runtime_dependency MATCHES "^[ \t]+(.+) \\(compatibility version")
            set(runtime_dependency "${CMAKE_MATCH_1}")
            if(runtime_dependency MATCHES "^(/System/Library/|/usr/lib/)")
                continue()
            endif()
            get_filename_component(runtime_name "${runtime_dependency}" NAME)
            # otool includes a dylib's own ID; rewrite it separately below.
            if(runtime_binary IN_LIST runtime_dylibs AND runtime_name STREQUAL runtime_binary_name)
                continue()
            endif()
            if(NOT EXISTS "${runtime_libraries}/${runtime_name}")
                message(FATAL_ERROR "Unpackaged dependency of ${runtime_binary}: ${runtime_dependency}")
            endif()
            list(APPEND runtime_changes -change "${runtime_dependency}" "${runtime_loader}/${runtime_name}")
        endif()
    endforeach()
    if(runtime_binary IN_LIST runtime_dylibs)
        get_filename_component(runtime_name "${runtime_binary}" NAME)
        string(CONCAT runtime_id "@" "loader_path/" "${runtime_name}")
        list(APPEND runtime_changes -id "${runtime_id}")
    endif()
    if(runtime_changes)
        execute_process(COMMAND "${runtime_install_name_tool}" ${runtime_changes} "${runtime_binary}"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
    # Changing load commands invalidates existing signatures. Ad-hoc signing
    # keeps local distribution executable on Apple Silicon.
    execute_process(COMMAND "${runtime_codesign}" --force --sign - "${runtime_binary}"
        COMMAND_ERROR_IS_FATAL ANY)
endforeach()
